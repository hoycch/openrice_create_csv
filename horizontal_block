// Extract OpenRice data and copy CSV to clipboard
const restaurants = Array.from(document.querySelectorAll('.poi-list-cell')).map(cell => {
    const titleEl = cell.querySelector('.poi-list-cell-title .poi-name');
    const name = titleEl ? titleEl.textContent.trim() : 'N/A';

    const linkEl = cell.querySelector('a.poi-list-cell-desktop-right-link-overlay');
    const url = linkEl ? 'https://www.openrice.com' + linkEl.getAttribute('href') : 'N/A';

    const smileEl = cell.querySelector('.smile.icon-wrapper.big-score .text');
    const smile = smileEl ? smileEl.textContent.trim() : 'N/A';

    const cryEl = cell.querySelector('.cry.icon-wrapper .text');
    const cry = cryEl ? cryEl.textContent.trim() : 'N/A';

    return { name, smile, cry, url };
});

// Create CSV content
const csvHeader = "Name,Smile,Cry,URL\n";
const csvRows = restaurants.map(r => 
    `"${r.name.replace(/"/g, '""')}",${r.smile},${r.cry},"${r.url}"`
).join("\n");

const csvContent = csvHeader + csvRows;

// Copy to clipboard
navigator.clipboard.writeText(csvContent).then(() => {
    console.log('%c✅ Successfully copied ' + restaurants.length + ' restaurants to clipboard as CSV!', 
        'color: lime; font-size: 16px; font-weight: bold');
    console.log('You can now paste it directly into Excel or Google Sheets.');
}).catch(err => {
    console.error('Failed to copy:', err);
});
